# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.

# Adresse publique du hub, sans / final (sert aussi d'adresse de retour pour Authentik).
ORIGIN=https://hub.exemple.fr
# Fichier SQLite (dans Docker : /data/hub.db, monté en volume).
DATABASE_PATH=./data/hub.db
# Clé de chiffrement des clés API Pelican : openssl rand -base64 32
HUB_ENCRYPTION_KEY=
# Facultatif : secret des cookies de connexion (Better Auth). Par défaut, dérivé de HUB_ENCRYPTION_KEY.
BETTER_AUTH_SECRET=

# --- Authentik (fournisseur OAuth2/OpenID, application « hub ») ---
# Adresse de l'issuer, visible dans Authentik › Applications › Fournisseurs.
AUTHENTIK_ISSUER=https://auth.exemple.fr/application/o/hub/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Groupes Authentik qui donnent accès au hub (membre) et aux réglages (admin).
AUTHENTIK_MEMBER_GROUP=hub-membres
AUTHENTIK_ADMIN_GROUP=hub-admins
# Groupe qui peut déposer des fichiers dans « Fichiers & applis » (les admins le peuvent toujours).
AUTHENTIK_FILES_GROUP=hub.files
# Facultatif : page où chacun modifie son profil (par défaut <issuer>/if/user/#/settings).
AUTHENTIK_PROFILE_URL=

# --- Steam (clé gratuite : https://steamcommunity.com/dev/apikey) ---
STEAM_API_KEY=

# --- IGDB (titres, séries et images des jeux) ---
# Crée une application sur https://dev.twitch.tv/console/apps (type « Confidentiel »)
# et reporte son Client ID et un secret. Facultatif : sans IGDB, les jeux se saisissent à la main.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- TMDB (films et séries de Ma watchlist) ---
# Clé gratuite : crée un compte sur https://www.themoviedb.org, puis Paramètres › API.
# Colle la « clé d'API » (v3) ou le « jeton d'accès en lecture » (v4). Sans elle, on ne peut pas ajouter de titre.
TMDB_API_KEY=

# --- Fichiers & applis ---
# Dossier des fichiers envoyés (par défaut : dossier « fichiers » à côté de la base, /data/fichiers dans Docker).
FICHIERS_PATH=
# Taille maximale d'un fichier, en octets ou avec une unité (500M, 2G). Par défaut 2G.
FICHIERS_TAILLE_MAX=

# --- Discord et tâches automatiques ---
# Webhook du salon où annoncer : serveur démarré depuis le hub, soirée film ou session de partie prévue le lendemain.
# Discord : Paramètres du salon › Intégrations › Webhooks › Nouveau webhook › Copier l'URL. Vide = pas d'annonce.
DISCORD_WEBHOOK_URL=
# Heures (de Paris) des tâches : actualisation des bibliothèques Steam (5 h) et annonces de la veille (18 h).
HEURE_SYNCHRO_STEAM=5
HEURE_ANNONCES=18
# TACHES=0 coupe les tâches automatiques (en développement, elles ne tournent qu'avec TACHES=1).
TACHES=

# --- Pelican / Sakura Panel ---
PELICAN_URL=https://panel.exemple.fr
# Facultatif : page des clés API (par défaut <PELICAN_URL>/profile?tab=api-keys).
PELICAN_API_KEYS_URL=
# Facultatif : adresse d'un serveur dans Pelican, {id} = identifiant court (par défaut <PELICAN_URL>/server/{id}).
PELICAN_SERVER_URL_TEMPLATE=

# --- Uptime Kuma (page de statut publique) ---
KUMA_URL=https://status.exemple.fr
KUMA_STATUS_SLUG=nohriancons

# --- Menu ---
# Lien « Planning » (agenda partagé, ouvert dans un nouvel onglet). « aucun » le masque.
PLANNING_URL=https://calendar.la-sikaverne.fr/

# --- Docker Compose ---
# Port local du hub (le reverse proxy pointe sur 127.0.0.1:HUB_PORT).
HUB_PORT=3000
# Nom de domaine du hub, seulement avec le profil « caddy » (docker compose --profile caddy up -d).
HUB_DOMAINE=hub.exemple.fr
# Sauvegarde quotidienne de la base : heure, durée de conservation, dossier sur le VPS.
HEURE_SAUVEGARDE=4
JOURS_A_GARDER=14
DOSSIER_SAUVEGARDES=./sauvegardes
TZ=Europe/Paris

# --- Développement uniquement ---
# DEV_LOGIN=1 ajoute une connexion de test sans Authentik, seulement avec « npm run dev ».
DEV_LOGIN=
